{
  "name": "scrum-master-notebook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.10.0",
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "db:sync:ceremonies": "tsx scripts/sync-ceremony-templates.ts",
    "db:diagnose": "tsx scripts/diagnose-schema.ts",
    "recover:admin": "node scripts/recover-admin.mjs",
    "i18n:check": "node scripts/verify-i18n.mjs",
    "pdf:doctor": "node scripts/report-pdf-doctor.mjs",
    "pdf:smoke": "node scripts/report-pdf-doctor.mjs --smoke",
    "db:upgrade": "tsx scripts/db-upgrade.ts",
    "db:diagnose:full": "tsx scripts/db-diagnostic-exhaustive.ts",
    "test:db:compat": "tsx --test tests/db-upgrade-v32-compatibility.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.0.0",
    "@prisma/client": "7.0.0",
    "better-auth": "1.4.5",
    "bootstrap": "5.3.8",
    "next": "16.0.0",
    "pg": "8.16.3",
    "puppeteer-core": "24.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.0",
    "prisma": "7.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
