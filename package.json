{
  "name": "scrum-master-notebook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.10.0",
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "db:sync:ceremonies": "tsx scripts/sync-ceremony-templates.ts",
    "db:diagnose": "tsx scripts/diagnose-schema.ts",
    "recover:admin": "node scripts/recover-admin.mjs",
    "i18n:check": "node scripts/verify-i18n.mjs",
    "pdf:doctor": "node scripts/report-pdf-doctor.mjs",
    "pdf:smoke": "node scripts/report-pdf-doctor.mjs --smoke",
    "db:upgrade": "tsx scripts/db-upgrade.ts",
    "db:migrate:red-purple": "tsx scripts/apply-red-purple-migration.ts",
    "db:diagnose:full": "tsx scripts/db-diagnostic-exhaustive.ts",
    "db:audit:smn-337": "tsx scripts/audit-smn-337-dependencies.ts",
    "test:db:compat": "tsx --test tests/db-upgrade-v32-compatibility.test.ts",
    "db:baseline:v32": "tsx scripts/generate-v32-baseline.ts",
    "test:db:baseline": "tsx --test tests/generate-v32-baseline.test.ts",
    "db:test:smn-338": "tsx --test tests/smn-338-postgres-integration.test.ts",
    "db:check:smn-338": "tsx scripts/check-smn-338-upgrade-readiness.ts --check",
    "db:test:smn-338:upgrade": "tsx --test tests/smn-338-v33-upgrade-dry-run.test.ts",
    "db:test:smn-338:restore": "tsx --test tests/smn-338-real-v32-restore.test.ts",
    "db:baseline:v33:candidate": "tsx scripts/build-smn-338-v33-baseline-candidate.ts --generate",
    "db:migrate:smn-338": "tsx scripts/apply-smn-338-v33.ts",
    "test:db:smn-338:contract": "tsx --test tests/smn-338-indicators-schema-contract.test.ts tests/db-upgrade-v32-compatibility.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.0.0",
    "@prisma/client": "7.0.0",
    "better-auth": "1.4.5",
    "bootstrap": "5.3.8",
    "next": "16.0.0",
    "pg": "8.16.3",
    "puppeteer-core": "24.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.0",
    "prisma": "7.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
