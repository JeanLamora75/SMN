    "db:compare:smn-351": "tsx scripts/smn-351-schema-compare.ts --check",
    "db:compare:smn-351:auto": "tsx scripts/smn-351-auto-compare.ts --check",
    "db:preflight:smn-351": "tsx scripts/smn-351-cleanup-preflight.ts --check",
    "db:audit:smn-351": "tsx scripts/smn-351-app-dependencies.ts --check",
    "db:test:smn-351": "tsx --test tests/smn-351-v33-capture-pg.test.ts",
    "test:smn-350": "tsx --test tests/smn-350-report-contract.test.ts",
    "db:test:smn-350": "tsx --test tests/smn-350-report-projection-pg.test.ts",
    "test:smn-349": "tsx --test tests/smn-349-reporting-contract.test.ts",
    "test:smn-348": "tsx --test tests/smn-348-input-contract.test.ts",
    "db:test:smn-348": "tsx --test tests/smn-348-input-pg.test.ts",
    "test:smn-347": "tsx --test tests/smn-347-ui-contract.test.ts tests/smn-347-team-grants-contract.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.0.0",
    "@prisma/client": "7.0.0",
    "better-auth": "1.4.5",
    "bootstrap": "5.3.8",
    "next": "16.0.0",
    "pg": "8.16.3",
    "puppeteer-core": "24.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.0",
    "prisma": "7.0.0",
