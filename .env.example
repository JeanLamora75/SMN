# Exemple documentaire uniquement, sans identifiant réel et non destiné à être commité en .env
# Le nom de base doit être smn ou commencer par smn_ ; hôte local uniquement.
# SMN_DATABASE_URL=postgresql://UTILISATEUR_LOCAL:MOT_DE_PASSE_LOCAL@127.0.0.1:5432/smn

# SMN-30 : emplacement ABSOLU de sauvegardes privées (facultatif sous Windows).
# Par défaut : %LOCALAPPDATA%/ScrumMasterNotebook/backups
# SMN_BACKUP_DIR=C:/Users/VOTRE_PROFIL/AppData/Local/ScrumMasterNotebook/backups
# SMN_PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
# Documents réellement stockés, hors du dépôt. Ne pas publier ces fichiers.
# SMN_PRIVATE_DOCUMENTS_DIR=C:/SMN/DocumentsPrives

# Mode multiéquipes — activation pilote locale après validation de l'isolation.
# Copier ces lignes dans .env.local (fichier non versionné) puis redémarrer SMN.
SMN_MULTI_TEAM_CONTEXT_READY=true
SMN_MULTI_TEAM_PILOT_ACK=I_ACCEPT_UNVERIFIED_ISOLATION
