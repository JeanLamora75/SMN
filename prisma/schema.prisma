  actor SmnAccount? @relation(fields:[createdBy],references:[id],onDelete:SetNull)
  @@unique([memberId,revision])
  @@map("smn_member_calendar_week")
}
model SmnMemberCalendarException {
  id String @id
  memberId String @map("member_id")
  onDate DateTime @map("on_date") @db.Date
  revision Int
  morning Boolean
  afternoon Boolean
  note String?
  createdBy String? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  member SmnMember @relation(fields:[memberId],references:[id],onDelete:Restrict)
  actor SmnAccount? @relation(fields:[createdBy],references:[id],onDelete:SetNull)
  @@unique([memberId,onDate,revision])
  @@map("smn_member_calendar_exception")
}

model SmnMemberLocation {
  id String @id
  memberId String @map("member_id")
  revision Int
  effectiveFrom DateTime @map("effective_from") @db.Date
  countryIso2 String? @map("country_iso2")
  region String?
  city String?
  timeZone String? @map("time_zone")
  source String
  createdBy String? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
