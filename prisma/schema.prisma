model SmnMemberAbsenceHistory {
  id String @id
  absenceId String @map("absence_id")
  revision Int
  operation String
  beforeValues Json? @map("before_values")
  afterValues Json @map("after_values")
  changedBy String? @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  absence SmnMemberAbsence @relation(fields:[absenceId],references:[id],onDelete:Restrict)
  actor SmnAccount? @relation(fields:[changedBy],references:[id],onDelete:SetNull)
  @@unique([absenceId,revision])
  @@index([absenceId,changedAt])
  @@map("smn_member_absence_history")
}

