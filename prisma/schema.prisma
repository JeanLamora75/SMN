generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model SmnInstallation {
  id String @id
  state String
  schemaVersion Int @map("schema_version")
  mode String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  products SmnProduct[]
  teams SmnTeam[]
  accounts SmnAccount[]
  generalSettings SmnGeneralSettings?
  generalSettingsHistory SmnGeneralSettingsAudit[]
  memberBatches SmnMemberBatch[]
  members SmnMember[]
  @@map("smn_installation")
}
model SmnProduct {
  id String @id
  installationId String @unique @map("installation_id")
  name String
  installation SmnInstallation @relation(fields: [installationId], references: [id])
  teams SmnTeam[]
  @@map("smn_product")
}
model SmnTeam {
  id String @id
  installationId String @unique @map("installation_id")
  productId String @map("product_id")
  name String
  installation SmnInstallation @relation(fields: [installationId], references: [id])
  product SmnProduct @relation(fields: [productId], references: [id])
  memberBatches SmnMemberBatch[]
  memberAssignments SmnMemberAssignment[]
  @@map("smn_team")
}
model SmnAccount {
  id String @id
  installationId String @map("installation_id")
  username String @unique
  email String @unique
  role String
  passwordHash String @map("password_hash")
  mustChangePassword Boolean @default(true) @map("must_change_password")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  installation SmnInstallation @relation(fields: [installationId], references: [id])
  recovery SmnRecoveryPhrase?
  authAudit SmnAuthAudit[]
  changedSettings SmnGeneralSettings[]
  settingsAudit SmnGeneralSettingsAudit[]
  @@map("smn_account")
}

model SmnRecoveryPhrase {
  accountId String @id @map("account_id")
  phraseHash String @map("phrase_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account SmnAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@map("smn_recovery_phrase")
}
model SmnAuthAudit {
  id String @id
  accountId String @map("account_id")
  action String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account SmnAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@map("smn_auth_audit")
}

model SmnGeneralSettings {
  installationId String @id @map("installation_id")
  locale String @default("fr")
  theme String @default("light")
  referenceCountry String? @map("reference_country")
  revision Int @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String? @map("updated_by")
  installation SmnInstallation @relation(fields:[installationId],references:[id])
  editor SmnAccount? @relation(fields:[updatedBy],references:[id],onDelete:SetNull)
  @@map("smn_general_settings")
}
model SmnGeneralSettingsAudit {
  id String @id
  installationId String @map("installation_id")
  actorId String? @map("actor_id")
  oldValues Json @map("old_values")
  newValues Json @map("new_values")
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  installation SmnInstallation @relation(fields:[installationId],references:[id])
  actor SmnAccount? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  @@map("smn_general_settings_audit")
}
\nmodel SmnMemberBatch {\n  id String @id\n  installationId String @map("installation_id")\n  teamId String @map("team_id")\n  requestedCount Int @map("requested_count")\n  createdBy String? @map("created_by")\n  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)\n  installation SmnInstallation @relation(fields:[installationId],references:[id])\n  team SmnTeam @relation(fields:[teamId],references:[id])\n  members SmnMember[]\n  @@map("smn_member_batch")\n}\nmodel SmnMember {\n  id String @id\n  installationId String @map("installation_id")\n  batchId String @map("batch_id")\n  memberNumber Int @map("member_number")\n  displayName String @map("display_name")\n  isProvisional Boolean @default(true) @map("is_provisional")\n  contractPercent Int @default(100) @map("contract_percent")\n  contributionPercent Int @default(100) @map("contribution_percent")\n  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)\n  installation SmnInstallation @relation(fields:[installationId],references:[id])\n  batch SmnMemberBatch @relation(fields:[batchId],references:[id])\n  assignments SmnMemberAssignment[]\n  @@unique([installationId,memberNumber])\n  @@map("smn_member")\n}\nmodel SmnMemberAssignment {\n  id String @id\n  memberId String @map("member_id")\n  teamId String @map("team_id")\n  startOn DateTime @default(now()) @map("start_on") @db.Date\n  endOn DateTime? @map("end_on") @db.Date\n  agileRole String @map("agile_role")\n  allocationPercent Int @default(100) @map("allocation_percent")\n  rolePercent Int @default(100) @map("role_percent")\n  member SmnMember @relation(fields:[memberId],references:[id])\n  team SmnTeam @relation(fields:[teamId],references:[id])\n  @@unique([memberId,teamId,startOn])\n  @@map("smn_member_assignment")\n}\n