generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model SmnInstallation {
  id String @id
  state String
  schemaVersion Int @map("schema_version")
  mode String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  products SmnProduct[]
  teams SmnTeam[]
  accounts SmnAccount[]
  generalSettings SmnGeneralSettings?
  generalSettingsHistory SmnGeneralSettingsAudit[]
  memberBatches SmnMemberBatch[]
  members SmnMember[]
  @@map("smn_installation")
}
model SmnProduct {
  id String @id
  installationId String @unique @map("installation_id")
  name String
  installation SmnInstallation @relation(fields: [installationId], references: [id])
  teams SmnTeam[]
  @@map("smn_product")
}
model SmnTeam {
  id String @id
  installationId String @unique @map("installation_id")
  productId String @map("product_id")
  name String
  installation SmnInstallation @relation(fields: [installationId], references: [id])
  product SmnProduct @relation(fields: [productId], references: [id])
  memberBatches SmnMemberBatch[]
  memberAssignments SmnMemberAssignment[]
  @@map("smn_team")
}
model SmnAccount {
  id String @id
  installationId String @map("installation_id")
  username String @unique
  email String @unique
  role String
  passwordHash String @map("password_hash")
  mustChangePassword Boolean @default(true) @map("must_change_password")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  installation SmnInstallation @relation(fields: [installationId], references: [id])
  recovery SmnRecoveryPhrase?
  authAudit SmnAuthAudit[]
  changedSettings SmnGeneralSettings[]
  settingsAudit SmnGeneralSettingsAudit[]
  assignmentChanges SmnMemberAssignmentVersion[]
  archivedMembers SmnMember[]
  changedCalendarWeeks SmnMemberCalendarWeek[]
  changedCalendarExceptions SmnMemberCalendarException[]
  changedLocations SmnMemberLocation[]
  createdCountries SmnCountry[]
  holidayCsvAudits SmnNationalHolidayAudit[]
  @@map("smn_account")
}

model SmnRecoveryPhrase {
  accountId String @id @map("account_id")
  phraseHash String @map("phrase_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account SmnAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@map("smn_recovery_phrase")
}
model SmnAuthAudit {
  id String @id
  accountId String @map("account_id")
  action String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account SmnAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@map("smn_auth_audit")
}

model SmnGeneralSettings {
  installationId String @id @map("installation_id")
  locale String @default("fr")
  theme String @default("light")
  referenceCountry String? @map("reference_country")
  revision Int @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String? @map("updated_by")
  installation SmnInstallation @relation(fields:[installationId],references:[id])
  editor SmnAccount? @relation(fields:[updatedBy],references:[id],onDelete:SetNull)
  @@map("smn_general_settings")
}
model SmnGeneralSettingsAudit {
  id String @id
  installationId String @map("installation_id")
  actorId String? @map("actor_id")
  oldValues Json @map("old_values")
  newValues Json @map("new_values")
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  installation SmnInstallation @relation(fields:[installationId],references:[id])
  actor SmnAccount? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  @@map("smn_general_settings_audit")
}

model SmnMemberBatch {
  id String @id
  installationId String @map("installation_id")
  teamId String @map("team_id")
  requestedCount Int @map("requested_count")
  createdBy String? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  installation SmnInstallation @relation(fields:[installationId],references:[id])
  team SmnTeam @relation(fields:[teamId],references:[id])
  members SmnMember[]
  @@map("smn_member_batch")
}
model SmnMember {
  id String @id
  installationId String @map("installation_id")
  batchId String @map("batch_id")
  memberNumber Int @map("member_number")
  displayName String @map("display_name")
  email String?
  revision Int @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  archivedBy String? @map("archived_by")
  archivedActor SmnAccount? @relation(fields:[archivedBy],references:[id],onDelete:SetNull)
  isProvisional Boolean @default(true) @map("is_provisional")
  contractPercent Int @default(100) @map("contract_percent")
  contributionPercent Int @default(100) @map("contribution_percent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  installation SmnInstallation @relation(fields:[installationId],references:[id])
  batch SmnMemberBatch @relation(fields:[batchId],references:[id])
  assignments SmnMemberAssignment[]
  calendarWeeks SmnMemberCalendarWeek[]
  calendarExceptions SmnMemberCalendarException[]
  locations SmnMemberLocation[]
  @@unique([installationId,memberNumber])
  @@map("smn_member")
}
model SmnMemberAssignment {
  id String @id
  memberId String @map("member_id")
  teamId String @map("team_id")
  startOn DateTime @default(dbgenerated("CURRENT_DATE")) @map("start_on") @db.Date
  endOn DateTime? @map("end_on") @db.Date
  agileRole String @map("agile_role")
  allocationPercent Int @default(100) @map("allocation_percent")
  rolePercent Int @default(100) @map("role_percent")
  member SmnMember @relation(fields:[memberId],references:[id])
  team SmnTeam @relation(fields:[teamId],references:[id])
  versions SmnMemberAssignmentVersion[]
  @@unique([memberId,teamId,startOn])
  @@map("smn_member_assignment")
}

model SmnMemberAssignmentVersion {
  id String @id
  assignmentId String @map("assignment_id")
  revision Int
  effectiveFrom DateTime @map("effective_from") @db.Date
  allocationPercent Int @map("allocation_percent")
  contractPercent Int @map("contract_percent")
  contributionPercent Int @map("contribution_percent")
  scrumMasterPercent Int @map("scrum_master_percent")
  productOwnerPercent Int @map("product_owner_percent")
  developerPercent Int @map("developer_percent")
  createdBy String? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  assignment SmnMemberAssignment @relation(fields:[assignmentId],references:[id])
  actor SmnAccount? @relation(fields:[createdBy],references:[id],onDelete:SetNull)
  @@unique([assignmentId,revision])
  @@map("smn_member_assignment_version")
}

model SmnMemberLifecycleEvent {
  id String @id
  memberId String @map("member_id")
  assignmentId String? @map("assignment_id")
  action String
  effectiveOn DateTime @map("effective_on") @db.Date
  performedBy String? @map("performed_by")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  details Json @default("{}")
  @@map("smn_member_lifecycle_event")
}

model SmnMemberCalendarWeek {
  id String @id
  memberId String @map("member_id")
  revision Int
  effectiveFrom DateTime @map("effective_from") @db.Date
  days Json
  createdBy String? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  member SmnMember @relation(fields:[memberId],references:[id],onDelete:Restrict)
  actor SmnAccount? @relation(fields:[createdBy],references:[id],onDelete:SetNull)
  @@unique([memberId,revision])
  @@map("smn_member_calendar_week")
}
model SmnMemberCalendarException {
  id String @id
  memberId String @map("member_id")
  onDate DateTime @map("on_date") @db.Date
  revision Int
  morning Boolean
  afternoon Boolean
  note String?
  createdBy String? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  member SmnMember @relation(fields:[memberId],references:[id],onDelete:Restrict)
  actor SmnAccount? @relation(fields:[createdBy],references:[id],onDelete:SetNull)
  @@unique([memberId,onDate,revision])
  @@map("smn_member_calendar_exception")
}

model SmnMemberLocation {
  id String @id
  memberId String @map("member_id")
  revision Int
  effectiveFrom DateTime @map("effective_from") @db.Date
  countryIso2 String? @map("country_iso2")
  region String?
  city String?
  timeZone String? @map("time_zone")
  source String
  createdBy String? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  member SmnMember @relation(fields:[memberId],references:[id],onDelete:Restrict)
  actor SmnAccount? @relation(fields:[createdBy],references:[id],onDelete:SetNull)
  @@unique([memberId,revision])
  @@map("smn_member_location")
}

model SmnCountry {
  code String @id
  name String
  origin String
  createdBy String? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor SmnAccount? @relation(fields:[createdBy],references:[id],onDelete:SetNull)
  nationalHolidays SmnNationalHoliday[]
  calendarCoverage SmnNationalCalendarCoverage[]
  holidayAudits SmnNationalHolidayAudit[]
  @@map("smn_country")
}

model SmnNationalHoliday {
  countryCode String @map("country_code")
  holidayDate DateTime @map("holiday_date") @db.Date
  name String
  country SmnCountry @relation(fields:[countryCode],references:[code],onDelete:Restrict)
  @@id([countryCode,holidayDate])
  @@map("smn_national_holiday")
}

model SmnNationalCalendarCoverage {
  countryCode String @map("country_code")
  calendarYear Int @map("calendar_year")
  status String
  entriesCount Int @default(0) @map("entries_count")
  diagnostic String?
  sourceFile String? @map("source_file")
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  country SmnCountry @relation(fields:[countryCode],references:[code],onDelete:Restrict)
  @@id([countryCode,calendarYear])
  @@map("smn_national_calendar_coverage")
}

model SmnNationalHolidayAudit {
  id String @id
  countryCode String @map("country_code")
  holidayDate DateTime @map("holiday_date") @db.Date
  previousName String? @map("previous_name")
  newName String @map("new_name")
  action String
  origin String
  actorId String? @map("actor_id")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  country SmnCountry @relation(fields:[countryCode],references:[code],onDelete:Restrict)
  actor SmnAccount? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  @@index([countryCode,holidayDate,occurredAt])
  @@map("smn_national_holiday_audit")
}
